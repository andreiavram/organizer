# Organizer on Coolify — environment DELTA against the old host's .env.
#
# Procedure: copy the old host's /var/app/organizer/.env, apply the changes below, paste the result
# into the Coolify application's environment editor ("Developer view" takes a whole .env at once).
# Every key not mentioned here keeps its current value. Never commit the filled-in file.
# Single-line values only: Coolify writes these to the stack's .env, which compose reads via env_file.

# --- MUST keep exactly ---------------------------------------------------------------------------

# INTEGRATIONS_TOKEN_KEY encrypts the stored Notion/VolunHub OAuth credentials. If the old .env has
# it, copy it verbatim. If it is EMPTY there, the key is derived from SECRET_KEY — then SECRET_KEY
# must be copied verbatim too, or every connected integration silently stops syncing.
# SECRET_KEY=<unchanged>
# INTEGRATIONS_TOKEN_KEY=<unchanged>

# Same public URL as today, so OAuth issuer/metadata, MCP connectors, the Notion redirect URI and the
# VolunHub client registration all stay valid. Changing the domain is a separate project.
# MCP_BASE_URL=https://<organizer domain>
# FRONTEND_BASE_URL=https://<organizer domain>
# ALLOWED_HOSTS=<organizer domain>
# CORS_ALLOWED_ORIGINS=<unchanged>

# --- MUST change ---------------------------------------------------------------------------------

# The database is the shared Coolify Postgres (postgis/postgis:17, resource "postgresql-database").
# DB_HOST is its container name — the resource UUID — reachable because the app is attached to the
# predefined `coolify` network.
DB_HOST=ouanf4qtdgssyb63r8vomcae
DB_PORT=5432
DB_NAME=organizer
DB_USER=organizer
DB_PASSWORD=<generated, the one used in README.md §1>

# The shared Coolify Redis (resource "redis-database-…", password on its resource page). DB numbers
# 6/7 keep clear of VolunHub's planned 0-3 (production) / 8-11 (staging) — check geogame's
# REDIS_URL index before relying on that.
CELERY_BROKER_URL=redis://default:<password>@hfxgixhepxvbl2fbcrrfsh40:6379/6
CHANNELS_REDIS_URL=redis://default:<password>@hfxgixhepxvbl2fbcrrfsh40:6379/7

# --- NEW keys (optional; defaults shown) ---------------------------------------------------------

# uvicorn worker processes in the web container. Channels fans out through Redis, and the MCP
# transport is stateless, so any number is safe.
WEB_CONCURRENCY=3
CELERY_WORKER_CONCURRENCY=2

# --- REMOVE / no longer meaningful ---------------------------------------------------------------

# DEBUG, STATIC_ROOT — forced by docker-compose.coolify.yml; anything pasted is overridden.
# DB_TEST_NAME, TEST_DB_TEMPLATE — dev/worktree only.
